# --- Required ---
TELEGRAM_TOKEN=123456:ABC-your-bot-token-from-BotFather
ANTHROPIC_API_KEY=sk-ant-...

# --- Google Sheets (optional but recommended) ---
GOOGLE_SHEET_ID=1AbC...the-long-id-from-your-sheet-url
GOOGLE_CREDS_PATH=google-creds.json

# --- HubSpot (optional but recommended) ---
HUBSPOT_TOKEN=pat-na1-...   # Private app access token

# --- Hardening (optional) ---
# Comma-separated Telegram user IDs allowed to use the bot.
# Leave blank to allow anyone who messages the bot (NOT recommended).
# Get your ID from @userinfobot on Telegram.
ALLOWED_USER_IDS=

# --- Vision model (optional override) ---
# Default is fast + cheap. Use claude-sonnet-4-6 for harder cards.
VISION_MODEL=claude-haiku-4-5-20251001
