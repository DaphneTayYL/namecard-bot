# Required: enter these values locally, never in a chat.
TELEGRAM_TOKEN=
# Choose anthropic (Claude) or openai; only fill the matching key.
VISION_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Your numeric Telegram ID; comma-separate for teammates.
ALLOWED_USER_IDS=

# Optional: leave empty to disable each destination.
GOOGLE_SHEET_ID=
GOOGLE_CREDS_PATH=google-creds.json
HUBSPOT_TOKEN=

# Blank uses the provider default. Set a model compatible with your chosen provider.
VISION_MODEL=
